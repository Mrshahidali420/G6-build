{
  "name": "gta6record",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-data.mjs && node scripts/build-music.mjs && node scripts/build-images.mjs && astro build && npx -y pagefind --site dist && node scripts/after-build.mjs",
    "data": "node scripts/build-data.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "images": "node scripts/build-images.mjs",
    "test": "node --test \"scripts/robot/*-test.mjs\"",
    "test:logic": "node --test scripts/robot/logic-test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "pagefind": "^1.4.0",
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
