---
// One icon set, one stroke weight. Each provenance level gets its own shape so
// the signal survives with colour removed, on a mono screen, or for a reader
// who cannot tell green from brass.
const { name, size = 16 } = Astro.props

const PATHS = {
  // Confirmed by Rockstar: a pressed seal with a tick in it.
  confirmed: 'M12 2.6 14.4 5l3.3-.4.8 3.2 2.9 1.6-1.5 3 1.5 3-2.9 1.6-.8 3.2-3.3-.4L12 21.4 9.6 19l-3.3.4-.8-3.2L2.6 14.6l1.5-3-1.5-3 2.9-1.6.8-3.2L9.6 5zM8.4 12.1l2.6 2.6 4.6-4.9',
  // Reported by the press: a folded newspaper.
  press: 'M4 5.5h13v13H4zM17 8.5h3v8a2 2 0 0 1-2 2H4M7 9h7M7 12h7M7 15h4',
  // Spotted by the community: an eye on the footage.
  community: 'M2.6 12S6 5.8 12 5.8 21.4 12 21.4 12 18 18.2 12 18.2 2.6 12 2.6 12Z M12 9.4a2.6 2.6 0 1 1 0 5.2 2.6 2.6 0 0 1 0-5.2Z',
  // Not confirmed: an open question.
  none: 'M12 3.2a8.8 8.8 0 1 1 0 17.6 8.8 8.8 0 0 1 0-17.6ZM9.5 9.6a2.6 2.6 0 1 1 3.3 2.7c-.5.2-.8.7-.8 1.3v.7M12 17.2v.1',
  // Navigation and utility, same stroke.
  arrow: 'M4.5 12h15M13.5 6l6 6-6 6',
  search: 'M10.8 4.2a6.6 6.6 0 1 1 0 13.2 6.6 6.6 0 0 1 0-13.2ZM15.6 15.6 20 20',
  calendar: 'M4.5 6.5h15v13h-15zM4.5 10.5h15M8.5 3.5v4M15.5 3.5v4',
  // Play a video: a triangle inside the same round frame as the question mark.
  play: 'M12 3.2a8.8 8.8 0 1 1 0 17.6 8.8 8.8 0 0 1 0-17.6ZM10.3 8.9l5.4 3.1-5.4 3.1z',
}
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[name] ?? PATHS.none} />
</svg>
