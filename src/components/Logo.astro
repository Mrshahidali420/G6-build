---
// The mark: a glazed tile in a brass frame, with a deco VI cut out of it and
// three terrazzo chips. Drawn, not typed, so it survives with no webfont.
const { size = 34 } = Astro.props
---
<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  role="img"
  aria-label="GTA 6 Record"
  focusable="false"
>
  <rect x="0.75" y="0.75" width="38.5" height="38.5" rx="3.5" fill="#b08637" />
  <rect x="3.25" y="3.25" width="33.5" height="33.5" rx="1.75" fill="#0a453e" />
  <circle cx="9.5" cy="33" r="1.5" fill="#b08637" opacity="0.75" />
  <circle cx="31.5" cy="8" r="1.1" fill="#eef5f2" opacity="0.4" />
  <circle cx="30" cy="33.5" r="0.9" fill="#a8492f" opacity="0.8" />
  <path
    d="M8 10.5h5.4l4.1 13.2 4.1-13.2H27L20.3 31h-5.6z"
    fill="#eef5f2"
  />
  <rect x="28.4" y="10.5" width="4.3" height="20.5" fill="#eef5f2" />
</svg>
