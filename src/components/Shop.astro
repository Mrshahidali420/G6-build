---
// The gear rail at the foot of every page.
//
// It is deliberately quiet and deliberately last. It sits below the page
// content and above the footer, so a reader who came for the record reads the
// record first and meets the shelf on the way out.
//
// The disclosure sits at the top of the block and not in small print at the
// bottom, because the Amazon Associates operating agreement asks for a clear
// statement and because a reader is owed it before the click, not after.
import Icon from './Icon.astro'
import { amazonUrl } from '../lib/site.mjs'
import { shopPicks } from '../lib/shop.mjs'

const { path } = Astro.props
const picks = shopPicks(path)
---
{picks.length > 0 && (
  <aside class="shop" aria-labelledby="shop-title">
    <div class="shell">
      <p class="shop__eyebrow">Paid links</p>
      <h2 class="shop__title" id="shop-title">Gear for playing GTA 6</h2>
      <p class="shop__note">
        These go to a search on Amazon. If you buy something after following one,
        this site may earn a commission at no extra cost to you. We have not
        tested this hardware and no prices are shown, because a price checked
        months ago would be wrong by the time you read it.
      </p>
      <ul class="shop__list">
        {picks.map((pick) => (
          <li class="shop__item">
            <p class="shop__name">{pick.name}</p>
            <p class="shop__why">{pick.why}</p>
            <a
              class="shop__link"
              href={amazonUrl(pick.search)}
              rel="nofollow sponsored noopener"
              target="_blank"
            >
              Search Amazon <Icon name="arrow" size={14} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
)}

<style>
  .shop {
    border-top: 1px solid var(--line-strong);
    background: var(--plaster);
    padding: 28px 0 32px;
  }
  .shop__eyebrow {
    margin: 0 0 4px;
    font: 600 0.66rem/1 var(--ui);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-ink, var(--ink-2));
  }
  .shop__title {
    margin: 0 0 8px;
    font: 700 1.15rem/1.25 var(--ui);
    color: var(--ink);
  }
  .shop__note {
    margin: 0 0 18px;
    max-width: 62ch;
    font: 400 13px/1.55 var(--body);
    color: var(--ink-2);
  }
  .shop__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shop__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: #fff;
  }
  .shop__name {
    margin: 0;
    font: 700 15px/1.3 var(--ui);
    color: var(--ink);
  }
  .shop__why {
    margin: 0;
    flex: 1 1 auto;
    font: 400 13px/1.5 var(--body);
    color: var(--ink-2);
  }
  .shop__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 600 13px/1 var(--ui);
    color: var(--brass-ink, var(--ink));
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .shop__link:hover {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .shop__list {
      grid-template-columns: 1fr;
    }
  }
</style>
