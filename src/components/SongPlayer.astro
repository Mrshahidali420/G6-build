---
// The cover and the 30 second preview for one song.
//
// Both the picture and the audio are served by Apple, from Apple's own public
// search endpoint. This site copies neither. Nothing is requested from Apple
// until the reader presses play, the same rule the video embeds follow, so a
// page nobody listens to costs nobody a third party request.
//
// The preview needs media-src in public/_headers. Without that line the browser
// blocks the audio and the button does nothing, so the two files move together.
import Icon from './Icon.astro'

const { track, name } = Astro.props
---
<figure class="song" data-preview={track.preview ?? ''}>
  {track.artwork && (
    <img
      class="song__art"
      src={track.artwork}
      alt={`Album cover for ${track.trackName} by ${track.artistName}`}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
    />
  )}

  <figcaption class="song__body">
    <p class="song__title">{track.trackName}</p>
    <p class="song__meta">
      {track.artistName}
      {track.albumName && <> &middot; {track.albumName}</>}
      {track.releaseYear && <> &middot; {track.releaseYear}</>}
    </p>

    {track.preview ? (
      <button class="song__play" type="button" aria-label={`Play a 30 second preview of ${name}`}>
        <Icon name="play" size={18} /> Play 30 second preview
      </button>
    ) : (
      <p class="song__meta">Apple publishes no preview for this record.</p>
    )}

    <p class="song__fine">
      Cover art and preview are served by Apple, not by this site.
      {track.appleUrl && (
        <> <a href={track.appleUrl} rel="nofollow noopener" target="_blank">Open on Apple Music</a>.</>
      )}
      {' '}Checked {track.checked}.
    </p>
  </figcaption>
</figure>

<style>
  .song {
    margin: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    border: 1px solid color-mix(in srgb, var(--brass) 38%, transparent);
    background: var(--plaster);
  }

  @media (min-width: 620px) {
    .song { grid-template-columns: 220px minmax(0, 1fr); }
  }

  .song__art {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 38%, transparent);
  }

  @media (min-width: 620px) {
    .song__art {
      border-bottom: 0;
      border-right: 1px solid color-mix(in srgb, var(--brass) 38%, transparent);
    }
  }

  .song__body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    align-items: flex-start;
  }

  .song__title {
    margin: 0;
    font-family: var(--display);
    font-stretch: 116%;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .song__meta {
    margin: 0;
    font-family: var(--display);
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .song__play {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 18px;
    background: var(--plaster);
    color: var(--ink);
    font-family: var(--display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: 0.92rem;
    border: 1px solid var(--brass);
    box-shadow: 0 2px 0 var(--glaze-deep);
    cursor: pointer;
  }

  .song__play:hover { background: #fff; box-shadow: 0 4px 0 var(--glaze-deep); }
  .song__play:focus-visible { outline: 3px solid var(--brass); outline-offset: 2px; }

  .song__fine {
    margin: 0;
    font-family: var(--display);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .song :global(audio) { width: 100%; max-width: 420px; }
</style>

<script>
  // The button is swapped for a real audio element on the first press, so the
  // reader gets the browser's own controls and nothing is fetched from Apple
  // before then.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.song__play')
    if (!button) return

    const figure = button.closest('.song') as HTMLElement | null
    const src = figure?.dataset.preview
    if (!figure || !src) return

    const audio = document.createElement('audio')
    audio.src = src
    audio.controls = true
    audio.autoplay = true
    audio.preload = 'none'
    button.replaceWith(audio)
  })
</script>
