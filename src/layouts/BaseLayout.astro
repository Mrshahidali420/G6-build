---
import { SITE_NAME, SITE_URL, ADSENSE_CLIENT, GA_MEASUREMENT_ID, HUB_TYPES, RECORD_PAGES, NAV_SHORTCUTS, canonical } from '../lib/site.mjs'
import { pageEntities } from '../lib/entities.mjs'
import Logo from '../components/Logo.astro'
import Icon from '../components/Icon.astro'
import '../styles/world.css'

const {
  title,
  description,
  path,
  jsonLd = null,
  noindex = false,
  updated = null,
} = Astro.props

if (!description) throw new Error(`Page ${path} has no meta description. Every page needs a unique one.`)

const url = canonical(path)
const year = new Date().getFullYear()
const current = (slug) => (path === `/${slug}` || path.startsWith(`/${slug}/`) ? 'page' : undefined)

// The six things the header row holds. Four are direct links; two are menus.
// A menu is marked as the current place when the page inside it is the current
// page, so a visitor reading /vehicles can still see which drawer they came
// out of.
const shortcuts = NAV_SHORTCUTS.map((slug) => RECORD_PAGES.find((page) => page.slug === slug)).filter(Boolean)

// The footer carries the same two numbers the home page opens with. A reader
// who lands deep in the site from a search result never sees the front page,
// so the footer is the only place that tells them how big the record is and
// how much of it Rockstar itself has confirmed.
const footTotal = pageEntities.length
const footConfirmed = pageEntities.filter((entity) => entity.confirmedStatus === 'OFFICIAL_CONFIRMED').length
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- AdSense site verification. Ships on every page. The loader script
         below is gated; this tag is not, so Google can always confirm the
         site belongs to this publisher. -->
    <meta name="google-adsense-account" content="ca-pub-2789392733984505" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <!--
      One card for the whole site, drawn by scripts/build-og.mjs from the same
      tokens as the pages. A per page picture would be better, but the site has
      almost no photographs it may publish, so a generated per page card would
      only restate the title in a second typeface. Without any card at all the
      platforms show a bare link, which reads as an abandoned site.
    -->
    <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: sourced, not guessed`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', SITE_URL).href} />
    <meta name="theme-color" content="#0f5d53" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      iOS and Android ask for a PNG, not an SVG. Without these a saved home
      screen shortcut shows a blank tile or a screenshot of the page.
    -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: news`} href="/rss.xml" />

    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4.woff2" as="font" type="font/woff2" crossorigin />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}

    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} />
        <script
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`}
        />
      </>
    )}
  </head>
  <body>
    <!--
      THESIS: this is a public record of what has actually been published about
      Grand Theft Auto VI, and it refuses the category arrangement of neon-night
      hero art over unsourced rumour lists.
      OWN-WORLD: Miami civic material in daylight. Terrazzo stone ground, deep
      glazed-tile fields owning whole page regions, brass rules and marks, fired
      clay for doubt. Archivo wide for lettering, Source Serif 4 for reading.
      Entries with no publishable photo get a poured terrazzo plate, not a box.
      STORY: the visitor sees a claim, sees who said it and when, believes the
      site is careful, and clicks deeper instead of leaving for a forum.
      FIRST VIEWPORT: a plaster masthead under a brass rule, over a full-width glaze band carrying
      the release facts as a ruled specification list; the brass "Every dated
      announcement" button sits under it, left aligned on the reading column.
      FORM: candidate 7 of 7 on the ordered direction list. Seed key 766292e9.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, DESIGN.md, and every shipping raster carrying
      its provenance.
    -->
    <a class="skip" href="#main">Skip to the page</a>

    <header class="mast">
      <!--
        One bar. It cannot overflow and it cannot wrap above the phone step,
        because nothing in it is a list that grows. The four direct links are a
        fixed four, and every other section lives in the panel, which is a grid
        and takes new rows without touching the bar. The full reasoning is in
        world.css above the .mast rules.
      -->
      <div class="mast__strip">
        <div class="shell mast__strip-in">
          <p class="mast__claim">A public record of Grand Theft Auto VI. Every entry shows where it came from.</p>
          <div class="mast__strip-links">
            <a href="/about">About and sources</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
      </div>

      <div class="mast__bar">
        <div class="shell mast__row">
          <a class="mast__brand" href="/">
            <Logo size={34} />
            <span class="mast__name">
              GTA 6 Record
              <small>Sourced, not guessed</small>
            </span>
          </a>

          <!--
            The one menu on the site. It serves a phone and a desktop from the
            same markup, so the two can never fall out of step, and it is a
            plain <details> so no navigation script ships. The panel is the full
            width of the masthead rather than a box hung off this button,
            because twenty-six links in a 500px box is a list, not a menu.
          -->
          <details class="browse">
            <summary class="browse__btn">
              <span class="browse__icon browse__icon--open"><Icon name="menu" size={17} /></span>
              <span class="browse__icon browse__icon--close"><Icon name="close" size={17} /></span>
              <span class="browse__label">All sections</span>
            </summary>
            <div class="browse__panel">
              <nav class="shell browse__cols" aria-label="All sections">
                <div class="browse__col">
                  <h2 class="browse__h">The catalogue</h2>
                  <p class="browse__note">Everything Rockstar has shown, sorted by kind.</p>
                  <ul class="browse__list browse__list--two">
                    {HUB_TYPES.map((hub) => (
                      <li><a href={`/${hub.slug}`} aria-current={current(hub.slug)}>{hub.nav}</a></li>
                    ))}
                  </ul>
                </div>

                <div class="browse__col">
                  <h2 class="browse__h">The record</h2>
                  <p class="browse__note">The parts of the site that are not a catalogue.</p>
                  <ul class="browse__list">
                    {RECORD_PAGES.map((page) => (
                      <li><a href={`/${page.slug}`} aria-current={current(page.slug)}>{page.title}</a></li>
                    ))}
                  </ul>
                </div>

                <div class="browse__col browse__col--site">
                  <h2 class="browse__h">This site</h2>
                  <p class="browse__note">How the record is kept, and how to reach us.</p>
                  <ul class="browse__list">
                    <li><a href="/about" aria-current={current('about')}>About and sources</a></li>
                    <li><a href="/updates" aria-current={current('updates')}>Daily coverage log</a></li>
                    <li><a href="/search" aria-current={current('search')}>Search every page</a></li>
                    <li><a href="/contact" aria-current={current('contact')}>Contact</a></li>
                  </ul>
                </div>
              </nav>
            </div>
          </details>

          <nav class="mast__quick" aria-label="Main sections">
            {shortcuts.map((page) => (
              <a href={`/${page.slug}`} aria-current={current(page.slug)}>{page.nav}</a>
            ))}
          </nav>

          <!--
            A plain GET form to /search, so it works with no JavaScript: the
            browser submits ?q=... and the search page runs that query on
            arrival. With JavaScript on, touching the field starts fetching the
            search index in the background.
          -->
          <form class="find" action="/search" method="get" role="search">
            <label class="find__label" for="site-search">Search this site</label>
            <input
              class="find__input"
              id="site-search"
              type="search"
              name="q"
              placeholder="Search a character, car, place or song"
              autocomplete="off"
              enterkeyhint="search"
            />
            <button class="find__btn" type="submit">
              <Icon name="search" size={16} />
              <span>Search</span>
            </button>
          </form>
        </div>
      </div>

      <script is:inline>
        // Warm the search up before it is asked for. The first touch of the
        // field starts fetching the results page and the Pagefind bundle in the
        // background, so by the time the visitor has finished typing a name the
        // browser usually has everything already. It runs once and costs
        // nothing on a page nobody searches from.
        (function () {
          var field = document.getElementById('site-search')
          if (!field) return
          var warmed = false
          var warm = function () {
            if (warmed) return
            warmed = true
            ;['/search', '/pagefind/pagefind-ui.js', '/pagefind/pagefind-ui.css', '/pagefind/pagefind.js'].forEach(
              function (href) {
                var link = document.createElement('link')
                link.rel = 'prefetch'
                link.href = href
                document.head.appendChild(link)
              },
            )
          }
          field.addEventListener('focus', warm, { once: true })
          field.addEventListener('pointerenter', warm, { once: true })
        })()
      </script>
    </header>

    <main id="main">
      <slot />
    </main>

    <!--
      The footer answers the header. The masthead opens with a thin glazed
      strip over a plaster bar under a brass rule; the footer closes with a
      brass rule over a plaster bar under a thin glazed strip. Same parts, same
      order, upside down, so the page reads as one object with a top and a
      bottom and not as a site with a decorated lid.

      Most readers here arrived on a deep page from a search result. The first
      thing the footer gives them is therefore not a link list: it is the name
      of the site, what it promises, and the size of the record, because that
      is what decides whether the link list is worth reading.
    -->
    <footer class="colophon">
      <div class="colophon__bar">
        <div class="shell colophon__bar-in">
          <a class="colophon__mark" href="/">
            <Logo size={34} />
            <span class="colophon__name">
              {SITE_NAME}
              <small>Sourced, not guessed</small>
            </span>
          </a>

          <p class="colophon__promise">
            An independent record of what has actually been published about
            Grand Theft Auto VI. Every entry names the source it came from and
            the date it was last checked.
          </p>

          <dl class="colophon__stats">
            <div>
              <dt>Entries on file</dt>
              <dd>{footTotal}</dd>
            </div>
            <div>
              <dt>Confirmed by Rockstar</dt>
              <dd>{footConfirmed}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="shell colophon__grid">
        <nav class="colophon__col colophon__col--wide" aria-label="Sections">
          <h2 class="colophon__head">The catalogue</h2>
          <ul class="colophon__links colophon__links--split">
            {HUB_TYPES.map((hub) => (
              <li><a href={`/${hub.slug}`}>{hub.title.replace('GTA 6 ', '')}</a></li>
            ))}
          </ul>
        </nav>

        <nav class="colophon__col" aria-label="The record">
          <h2 class="colophon__head">The record</h2>
          <ul class="colophon__links">
            {RECORD_PAGES.map((page) => (
              <li><a href={`/${page.slug}`}>{page.title}</a></li>
            ))}
          </ul>
        </nav>

        <nav class="colophon__col" aria-label="This site">
          <h2 class="colophon__head">This site</h2>
          <ul class="colophon__links">
            <li><a href="/about">About and sources</a></li>
            <li><a href="/updates">Daily coverage log</a></li>
            <li><a href="/search">Search every page</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </nav>

        <div class="colophon__col">
          <h2 class="colophon__head">Why you can trust it</h2>
          <ul class="colophon__trust">
            <li>Every claim links the source that published it.</li>
            <li>Each page prints the day it was last checked.</li>
            <li>A rumour is marked as a rumour, or it is left out.</li>
            <li>Found a mistake? <a href="/contact">Tell us</a> and it gets fixed.</li>
          </ul>
        </div>
      </div>

      <div class="colophon__strip">
        <div class="shell colophon__strip-in">
          <p class="colophon__fine">
            Not affiliated with Rockstar Games or Take-Two Interactive. Grand
            Theft Auto is a trademark of Take-Two Interactive Software, Inc. Any
            game imagery belongs to Rockstar Games and is shown for reference
            only. &copy; {year} {SITE_URL.replace('https://', '')}
          </p>
          {updated && (
            <p class="colophon__checked">
              <Icon name="calendar" size={14} /> This page was checked {updated}.
            </p>
          )}
        </div>
      </div>
    </footer>
  </body>
</html>
