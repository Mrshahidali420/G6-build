---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import EntityTile from '../components/EntityTile.astro'
import Icon from '../components/Icon.astro'
import Video from '../components/Video.astro'
import Countdown from '../components/Countdown.astro'
import { SITE_NAME, SITE_URL, canonical, amazonUrl } from '../lib/site.mjs'
import { bySlug } from '../lib/entities.mjs'

export async function getStaticPaths() {
  const pages = await getCollection('answers')
  return pages.map((page) => ({ params: { answer: page.id }, props: { page } }))
}

const { page } = Astro.props
const { Content } = await render(page)
const path = `/${page.id}`
const data = page.data

const related = data.related.map((slug) => bySlug.get(slug)).filter(Boolean)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${canonical(path)}#faq`,
      mainEntity: data.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
    {
      '@type': 'Article',
      '@id': canonical(path),
      headline: data.title,
      description: data.description,
      dateModified: data.updated,
      mainEntityOfPage: canonical(path),
      publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      citation: data.sources.map((source) => ({ '@type': 'WebPage', name: source.label, url: source.url })),
    },
  ],
}
---
<BaseLayout title={data.title} description={data.description} path={path} updated={data.updated} jsonLd={jsonLd}>
  <section class="band band--glaze">
    <div class="shell">
      <p class="crumb" style="color:var(--on-glaze-2)">
        <a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> / Answer
      </p>
      <h1 style="max-width:20ch">{data.title}</h1>
      <p class="lede">{data.description}</p>
      {data.updated && (
        <p class="plaque__meta" style="color:var(--on-glaze-2);display:flex;align-items:center;gap:7px">
          <Icon name="calendar" size={15} /> Checked {data.updated}
        </p>
      )}
    </div>
  </section>

  {data.countdown && (
    <section class="band band--glaze">
      <div class="shell">
        <Countdown />
      </div>
    </section>
  )}

  <section class="band">
    <div class="shell prose article">
      <Content />
    </div>
  </section>

  {data.videos.length > 0 && (
    <section class="band band--plaster">
      <div class="shell">
        <h2 style="margin-top:0">Watch them here</h2>
        <p class="lede">
          Every video below sits on Rockstar's own YouTube channel. Channel
          ownership was checked through YouTube's oEmbed endpoint, not copied
          from another site, because mirrors and fan reuploads carry the same
          footage under a different owner. Nothing loads from YouTube until you
          press play.
        </p>
        <div class="videos">
          {data.videos.map((video) => (
            <Video
              id={video.id}
              title={video.title}
              date={video.date}
              runtime={video.runtime}
              channel={video.channel}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {data.products.length > 0 && (
    <section class="band band--plaster">
      <div class="shell">
        <h2 style="margin-top:0">What to buy</h2>
        <p class="lede">
          These links go to Amazon. If you buy something after following one, this
          site may earn a commission at no extra cost to you. That never changes
          what is written here. No prices are listed, because a price we checked
          months ago would be wrong by the time you read it.
        </p>
        <ul class="tiles tiles--wide">
          {data.products.map((product) => (
            <li class="tile">
              <div class="tile__body">
                <p class="tile__title" style="margin:0">{product.name}</p>
                <p class="plaque__meta" style="margin:0;color:var(--brass-ink)">Best for {product.bestFor}</p>
                <p class="tile__text">{product.why}</p>
                {product.watchOut && (
                  <p class="tile__text" style="color:var(--clay)">Watch out: {product.watchOut}</p>
                )}
                <div class="tile__foot">
                  <a class="btn" href={amazonUrl(product.search)} rel="nofollow sponsored noopener" target="_blank">
                    Check it on Amazon <Icon name="arrow" size={15} />
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band">
    <div class="shell prose">
      <h2 style="margin-top:0">Common questions</h2>
      <dl class="spec" style="grid-template-columns:1fr">
        {data.faq.map((item) => (
          <>
            <dt style="white-space:normal;font-size:0.95rem;font-family:var(--display);font-stretch:112%;text-transform:none;letter-spacing:0;color:var(--ink);padding-bottom:4px;border-bottom:0">{item.q}</dt>
            <dd style="padding-top:0;color:var(--ink-2)">{item.a}</dd>
          </>
        ))}
      </dl>

      <h2>Where this comes from</h2>
      <div class="plaque">
        <ul>
          {data.sources.map((source) => (
            <li><a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a></li>
          ))}
        </ul>
        <p class="plaque__meta">Checked {data.updated}. Found a mistake? <a href="/contact">Tell us</a>.</p>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="band band--plaster">
      <div class="shell">
        <h2 style="margin-top:0">Related entries</h2>
        <ul class="tiles">
          {related.map((item) => <EntityTile entity={item} />)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* One column on a phone, two from tablet width up. The minimum is 280px so
     a video never forces the page sideways at 400px. */
  .videos {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
