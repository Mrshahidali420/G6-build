---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { HUB_TYPES } from '../../lib/site.mjs'
import { entitiesOfType, hubFor, relatedFor, urlFor, STATUS_LABEL, TIER_LABEL } from '../../lib/entities.mjs'
import { entitySchema } from '../../lib/schema.mjs'

export function getStaticPaths() {
  return HUB_TYPES.flatMap((hub) =>
    entitiesOfType(hub.type).map((entity) => ({
      params: { hub: hub.slug, slug: entity.slug },
      props: { entity, hub },
    })),
  )
}

const { entity, hub } = Astro.props
const path = urlFor(entity)
const related = relatedFor(entity)
const confirmed = entity.confirmedStatus === 'OFFICIAL_CONFIRMED'
const weak = entity.confidence === 'LOW' || entity.sourceTier === 'TIER_3_COMMUNITY'

// Unique per page. Never a template with the name swapped in.
const description = entity.shortDescription.slice(0, 155)
---
<BaseLayout
  title={entity.name}
  description={description}
  path={path}
  updated={entity.sourceDate}
  jsonLd={entitySchema(entity, path)}
>
  <p style="font-size:14px;margin:0 0 12px">
    <a href={`/${hub.slug}`}>{hub.title}</a>
  </p>

  <h1>{entity.name}</h1>

  <p>
    <span class={`badge ${confirmed ? 'ok' : weak ? 'warn' : ''}`}>
      {STATUS_LABEL[entity.confirmedStatus] ?? entity.confirmedStatus}
    </span>
    <span class="badge">{TIER_LABEL[entity.sourceTier] ?? entity.sourceTier}</span>
  </p>

  {entity.altNames.length > 0 && (
    <p class="lede">Also called {entity.altNames.join(', ')}.</p>
  )}

  <p>{entity.longDescription}</p>

  {entity.keyFacts.length > 0 && (
    <>
      <h2>Key facts</h2>
      <ul class="facts">
        {entity.keyFacts.map((fact) => <li>{fact}</li>)}
      </ul>
    </>
  )}

  {entity.realWorldBasis && (
    <>
      <h2>Real world basis</h2>
      <p>{entity.realWorldBasis}</p>
    </>
  )}

  <h2>Where this comes from</h2>
  <div class="source">
    {entity.firstShownIn && <p style="margin-top:0">First shown in: {entity.firstShownIn}{entity.firstShownDate && <> ({entity.firstShownDate})</>}</p>}
    {entity.sources.length > 0 ? (
      <ul style="margin:0;padding-left:18px">
        {entity.sources.map((url) => <li><a href={url} rel="nofollow noopener" target="_blank">{url}</a></li>)}
      </ul>
    ) : (
      <p style="margin:0">No published source. This entry is listed as unconfirmed.</p>
    )}
    {entity.sourceDate && <p style="margin-bottom:0;color:var(--muted)">Source checked {entity.sourceDate}.</p>}
  </div>

  {related.length > 0 && (
    <>
      <h2>Related</h2>
      <ul class="grid">
        {related.map((item) => (
          <li class="card">
            <a href={urlFor(item)}>{item.name}</a>
            <p>{item.shortDescription.slice(0, 90)}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
