---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Ad from '../../components/Ad.astro'
import Plate from '../../components/Plate.astro'
import Gallery from '../../components/Gallery.astro'
import SongPlayer from '../../components/SongPlayer.astro'
import Mark from '../../components/Mark.astro'
import EntityTile from '../../components/EntityTile.astro'
import { HUB_TYPES, ENTITY_ANSWER_LINKS, BOOST_LINKS } from '../../lib/site.mjs'
import Evidence from '../../components/Evidence.astro'
import { entitiesOfType, hubFor, relatedFor, urlFor, metaTitle, pageDescription, osmUrl, inGameHeading, inGameRows, withInGameSchema, TIER_LABEL } from '../../lib/entities.mjs'
import { labelFor } from '../../lib/evidence.mjs'
import { shotsForEntity } from '../../lib/shots.mjs'
import { mentionsFor } from '../../lib/entity-mentions.mjs'
import { entitySchema } from '../../lib/schema.mjs'
import { imageFor, creditFor, creditSourceFor, galleryFor } from '../../lib/images.mjs'
import { trackFor } from '../../lib/music.mjs'
import { factsFor, statusForTier } from '../../lib/facts.mjs'

export function getStaticPaths() {
  return HUB_TYPES.flatMap((hub) =>
    entitiesOfType(hub.type).map((entity) => ({
      params: { hub: hub.slug, slug: entity.slug },
      props: { entity, hub },
    })),
  )
}

const { entity, hub } = Astro.props
const path = urlFor(entity)
const related = relatedFor(entity)
const photo = imageFor(entity.slug)
const credit = creditFor(entity.slug)
const creditSource = creditSourceFor(entity.slug)

// The hero already shows the first picture, so the gallery gets the rest.
const shots = galleryFor(entity.slug).slice(1)

// What outlets have reported about this entry since it was written. The robot
// appends to data/robot/facts/<slug>.json and never edits a word above, so this
// section can grow without anything a person wrote changing.
const reported = factsFor(entity.slug)

// A song entry shows its real cover and a preview instead of a terrazzo plate,
// when Apple publishes one for that record. When it does not, the plate stays.
const track = entity.entityType === 'song' ? trackFor(entity.slug) : null

// Unique per page. Never a template with the name swapped in. Both helpers
// live in lib/entities.mjs, with the Search Console reading that explains them.
const pageTitle = metaTitle(entity)
const description = pageDescription(entity)

// Where to find it, filled by hand after launch in data/ingame.json. Until an
// entry has a row there, all three are empty and the page renders as before.
const inGame = entity.inGame
const inGameTitle = inGameHeading(entity)
const inGameFacts = inGameRows(entity)

// The answer page that owns this entry's main question, so the two pages
// link both ways instead of competing for one search.
const answerLink = ENTITY_ANSWER_LINKS[entity.slug]
const boostLink = BOOST_LINKS[path]

// The evidence label says what kind of evidence sits behind the entry. The
// stamp already says how sure the site is, and for most entries the two say
// the same thing (confirmed / official, press / press). The label is shown
// only when it adds something, such as "Seen in trailer, Trailer 1 at 0:32".
const MARK_EVIDENCE = {
  OFFICIAL_CONFIRMED: 'official',
  PRESS_REPORTED: 'press',
  COMMUNITY_IDENTIFIED: 'community',
  UNCONFIRMED: 'unverified',
}
const evidence = labelFor(entity)
const showEvidence = evidence.key !== (MARK_EVIDENCE[entity.confirmedStatus] ?? 'unverified')

// Every moment an official video links to this entry. Empty for most.
const trailerShots = shotsForEntity(entity.slug)

// Real-world counterparts, each from its own credited source (data/extras).
const realLife = entity.realLife
const realPlace = entity.realPlace
const species = entity.species

// "community-identified" or "community-identified (series design)", the second
// when the wiki's design text covers every game rather than GTA VI alone.
const realLifeBasis = realLife
  ? (realLife.basis ?? 'community-identified').replace(/^./, (c) => c.toUpperCase())
  : ''
// A photo of the real vehicle, never a game image. It stays in this row and
// never feeds the hero, tiles or OG image (see scripts/build-data.mjs).
const realPhoto = realLife?.photo

// News, Newswire posts and tracker claims that name this entry, newest first.
const mentions = await mentionsFor(entity.slug)
---
<BaseLayout
  title={pageTitle}
  description={description}
  path={path}
  updated={entity.sourceDate}
  jsonLd={withInGameSchema(entitySchema(entity, path), entity)}
>
  <section class="band band--glaze">
    <div class="shell hero">
      <div class="hero__text">
        <p class="crumb" style="color:var(--on-glaze-2)">
          <a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> /
          <a href={`/${hub.slug}`} style="color:var(--on-glaze-2)">{hub.title.replace('GTA 6 ', '')}</a>
        </p>

        <h1>{entity.name}</h1>

        {entity.altNames.length > 0 && (
          <p class="lede">Also called {entity.altNames.join(', ')}.</p>
        )}

        <div class="marks">
          <Mark status={entity.confirmedStatus} as="stamp" />
          {showEvidence && <Evidence label={evidence} showDetail />}
        </div>

        <dl class="spec" style="max-width:32rem">
          {entity.firstShownIn && (
            <>
              <dt>First shown in</dt>
              <dd>{entity.firstShownIn}{entity.firstShownDate && <> ({entity.firstShownDate})</>}</dd>
            </>
          )}
          <dt>Source strength</dt>
          <dd>{TIER_LABEL[entity.sourceTier] ?? entity.sourceTier}</dd>
          {entity.subcategory && (
            <>
              <dt>Type</dt>
              <dd>{entity.subcategory}</dd>
            </>
          )}
          {realLife && (
            <>
              <dt>Real-life basis</dt>
              <dd class="real-basis">
                {realLife.basedOn}. {realLifeBasis}, source:{' '}
                <a href={realLife.source.url} rel="nofollow noopener" target="_blank">{realLife.source.label}</a>.
                {realPhoto && (
                  <figure class="real-photo">
                    <img
                      src={realPhoto.src}
                      width={realPhoto.width}
                      height={realPhoto.height}
                      alt={`Real ${realLife.basedOn}, the car the ${entity.name} is based on`}
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>
                      <strong class="real-photo__label">Real car, not a game image</strong>
                      {realPhoto.credit}{' '}
                      <a href={realPhoto.source} rel="nofollow noopener" target="_blank">File page</a>.
                    </figcaption>
                  </figure>
                )}
              </dd>
            </>
          )}
          {realPlace && (
            <>
              <dt>Real-world place</dt>
              <dd>
                {realPlace.address}. Community-identified, source:{' '}
                <a href={realPlace.source.url} rel="nofollow noopener" target="_blank">{realPlace.source.label}</a>.{' '}
                <a href={osmUrl(realPlace)} rel="nofollow noopener" target="_blank">View on map</a>
              </dd>
            </>
          )}
          {species && (
            <>
              <dt>Real species</dt>
              <dd>
                {species.commonName} (<i>{species.scientificName}</i>). Matched by name, source:{' '}
                <a href={species.source.url} rel="nofollow noopener" target="_blank">{species.source.label}</a>.
              </dd>
            </>
          )}
          {entity.sourceDate && (
            <>
              <dt>Checked</dt>
              <dd>{entity.sourceDate}</dd>
            </>
          )}
        </dl>
      </div>

      {track ? (
        <div class="hero__plate">
          <SongPlayer track={track} name={entity.name} />
        </div>
      ) : (
      <figure class="hero__plate">
        <Plate entity={entity} eager={true} className="hero__img" chipCount={17} sizes="(max-width: 760px) 100vw, 620px" />
        <figcaption>
          {photo
            ? (<>{credit ?? 'Image: Rockstar Games. Shown for reference only.'}{creditSource && <> <a href={creditSource} rel="nofollow noopener" target="_blank" style="color:inherit">Source</a>.</>}</>)
            : 'No picture of this entry has been published that we may show. The plate is drawn from its section colour.'}
        </figcaption>
      </figure>
      )}
    </div>
  </section>

  <section class="band">
    <div class="shell prose">
      <p style="font-size:1.12rem">{entity.longDescription}</p>

      {answerLink && (
        <p><a href={answerLink.href}>{answerLink.label}</a></p>
      )}

      {boostLink && (
        <p>{boostLink.lead} <a href={boostLink.href}>{boostLink.anchor}</a>.</p>
      )}

      {inGame && inGameFacts.length > 0 && (
        <>
          <h2>{inGameTitle}</h2>
          <div class="plaque">
            <dl class="spec">
              {inGameFacts.map(([label, value]) => (
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              ))}
            </dl>
            <p class="plaque__meta">
              In the game. Source: <a href={inGame.source.url} rel="nofollow noopener" target="_blank">{inGame.source.label}</a>.
            </p>
          </div>
        </>
      )}

      {entity.keyFacts.length > 0 && (
        <>
          <h2>Key facts</h2>
          <ul class="facts">
            {entity.keyFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </>
      )}

      {trailerShots.length > 0 && (
        <>
          <h2>Seen in the trailers</h2>
          <ol class="since">
            {trailerShots.map((shot) => (
              <li class="since__item">
                <p class="since__fact"><a href={shot.url}>{shot.label}</a></p>
                {shot.note && <p class="since__quote">{shot.note}</p>}
                <p class="since__meta">
                  <a href={shot.youtube} rel="nofollow noopener" target="_blank">Watch on YouTube at {shot.timestamp}</a>
                </p>
              </li>
            ))}
          </ol>
        </>
      )}

      {entity.realWorldBasis && (
        <>
          <h2>Real world basis</h2>
          <p>{entity.realWorldBasis}</p>
        </>
      )}

      {entity.notKnown?.length > 0 && (
        <>
          <h2>What is still unknown</h2>
          <p>
            These are the open questions about {entity.name}. Nothing below has been
            answered by Rockstar, so this site does not answer it either.
          </p>
          <ul class="facts facts--open">
            {entity.notKnown.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}

      {entity.howWeKnow && (
        <>
          <h2>How this entry was built</h2>
          <p>{entity.howWeKnow}</p>
        </>
      )}

      <h2>Where this comes from</h2>
      <div class="plaque">
        {entity.sources.length > 0 ? (
          <ul>
            {entity.sources.map((url) => <li><a href={url} rel="nofollow noopener" target="_blank">{url}</a></li>)}
          </ul>
        ) : (
          <p>No published source. This entry is listed as unconfirmed.</p>
        )}
        <p class="plaque__meta">
          {TIER_LABEL[entity.sourceTier] ?? entity.sourceTier}.
          {entity.sourceDate && <> Checked {entity.sourceDate}.</>}
          {' '}Found a mistake? <a href="/contact">Tell us</a>.
        </p>
      </div>
    </div>
  </section>

  {shots.length > 0 && (
    <section class="band band--plaster">
      <div class="shell">
        <h2 style="margin-top:0">More pictures of {entity.name}</h2>
        <p class="lede">
          Every picture below was published by Rockstar Games. Each one names the
          file it came from and links back to the page that published it.
        </p>
        <Gallery shots={shots} name={entity.name} />
      </div>
    </section>
  )}

  {reported.length > 0 && (
    <section class="band band--plaster">
      <div class="shell prose">
        <h2 style="margin-top:0">Reported since this entry was written</h2>
        <p class="lede">
          Each line below records that an outlet published something about {entity.name}
          after this entry was made. The outlet's own words are quoted and linked. A
          report is not a confirmation, and the mark next to each one says which it is.
        </p>
        <ol class="since">
          {reported.map((item) => (
            <li class="since__item">
              {item.fact !== item.quote && <p class="since__fact">{item.fact}</p>}
              <p class="since__quote">"{item.quote}"</p>
              <p class="since__meta">
                <Mark status={statusForTier(item.tier)} />
                <a href={item.url} rel="nofollow noopener" target="_blank">{item.outlet}</a>
                {item.published && <span class="since__date">{item.published}</span>}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {mentions.length > 0 && (
    <section class="band band--plaster">
      <div class="shell prose">
        <h2 style="margin-top:0">Mentioned in</h2>
        <p class="lede">
          The latest news posts, Rockstar Newswire posts and tracked claims that
          name {entity.name}, newest first.
        </p>
        <ul class="since">
          {mentions.map((item) => (
            <li class="since__item">
              <p class="since__fact">
                {item.external
                  ? <a href={item.href} rel="nofollow noopener" target="_blank">{item.title}</a>
                  : <a href={item.href}>{item.title}</a>}
              </p>
              <p class="since__meta">
                <span>{item.kindLabel}</span>
                {item.date && <span class="since__date">{item.date}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {entity.faq?.length > 0 && (
    <section class="band band--plaster">
      <div class="shell prose">
        <h2 style="margin-top:0">Common questions about {entity.name}</h2>
        <dl class="qa">
          {entity.faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="band">
      <div class="shell">
        <h2 style="margin-top:0">Related entries</h2>
        <ul class="tiles">
          {related.map((item) => <EntityTile entity={item} />)}
        </ul>
      </div>
    </section>
  )}
  <Ad placement="foot" />
</BaseLayout>
