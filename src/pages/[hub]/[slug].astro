---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Ad from '../../components/Ad.astro'
import Plate from '../../components/Plate.astro'
import Gallery from '../../components/Gallery.astro'
import SongPlayer from '../../components/SongPlayer.astro'
import Mark from '../../components/Mark.astro'
import EntityTile from '../../components/EntityTile.astro'
import { HUB_TYPES } from '../../lib/site.mjs'
import { entitiesOfType, hubFor, relatedFor, urlFor, TIER_LABEL } from '../../lib/entities.mjs'
import { entitySchema } from '../../lib/schema.mjs'
import { imageFor, creditFor, creditSourceFor, galleryFor } from '../../lib/images.mjs'
import { trackFor } from '../../lib/music.mjs'
import { factsFor, statusForTier } from '../../lib/facts.mjs'

export function getStaticPaths() {
  return HUB_TYPES.flatMap((hub) =>
    entitiesOfType(hub.type).map((entity) => ({
      params: { hub: hub.slug, slug: entity.slug },
      props: { entity, hub },
    })),
  )
}

const { entity, hub } = Astro.props
const path = urlFor(entity)
const related = relatedFor(entity)
const photo = imageFor(entity.slug)
const credit = creditFor(entity.slug)
const creditSource = creditSourceFor(entity.slug)

// The hero already shows the first picture, so the gallery gets the rest.
const shots = galleryFor(entity.slug).slice(1)

// What outlets have reported about this entry since it was written. The robot
// appends to data/robot/facts/<slug>.json and never edits a word above, so this
// section can grow without anything a person wrote changing.
const reported = factsFor(entity.slug)

// A song entry shows its real cover and a preview instead of a terrazzo plate,
// when Apple publishes one for that record. When it does not, the plate stays.
const track = entity.entityType === 'song' ? trackFor(entity.slug) : null

// Unique per page. Never a template with the name swapped in.
const description = entity.shortDescription.slice(0, 155)
---
<BaseLayout
  title={entity.name}
  description={description}
  path={path}
  updated={entity.sourceDate}
  jsonLd={entitySchema(entity, path)}
>
  <section class="band band--glaze">
    <div class="shell hero">
      <div class="hero__text">
        <p class="crumb" style="color:var(--on-glaze-2)">
          <a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> /
          <a href={`/${hub.slug}`} style="color:var(--on-glaze-2)">{hub.title.replace('GTA 6 ', '')}</a>
        </p>

        <h1>{entity.name}</h1>

        {entity.altNames.length > 0 && (
          <p class="lede">Also called {entity.altNames.join(', ')}.</p>
        )}

        <div class="marks">
          <Mark status={entity.confirmedStatus} as="stamp" />
        </div>

        <dl class="spec" style="max-width:32rem">
          {entity.firstShownIn && (
            <>
              <dt>First shown in</dt>
              <dd>{entity.firstShownIn}{entity.firstShownDate && <> ({entity.firstShownDate})</>}</dd>
            </>
          )}
          <dt>Source strength</dt>
          <dd>{TIER_LABEL[entity.sourceTier] ?? entity.sourceTier}</dd>
          {entity.subcategory && (
            <>
              <dt>Type</dt>
              <dd>{entity.subcategory}</dd>
            </>
          )}
          {entity.sourceDate && (
            <>
              <dt>Checked</dt>
              <dd>{entity.sourceDate}</dd>
            </>
          )}
        </dl>
      </div>

      {track ? (
        <div class="hero__plate">
          <SongPlayer track={track} name={entity.name} />
        </div>
      ) : (
      <figure class="hero__plate">
        <Plate entity={entity} eager={true} className="hero__img" chipCount={17} sizes="(max-width: 760px) 100vw, 620px" />
        <figcaption>
          {photo
            ? (<>{credit ?? 'Image: Rockstar Games. Shown for reference only.'}{creditSource && <> <a href={creditSource} rel="nofollow noopener" target="_blank" style="color:inherit">Source</a>.</>}</>)
            : 'No picture of this entry has been published that we may show. The plate is drawn from its section colour.'}
        </figcaption>
      </figure>
      )}
    </div>
  </section>

  <section class="band">
    <div class="shell prose">
      <p style="font-size:1.12rem">{entity.longDescription}</p>

      {entity.keyFacts.length > 0 && (
        <>
          <h2>Key facts</h2>
          <ul class="facts">
            {entity.keyFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </>
      )}

      {entity.realWorldBasis && (
        <>
          <h2>Real world basis</h2>
          <p>{entity.realWorldBasis}</p>
        </>
      )}

      {entity.notKnown?.length > 0 && (
        <>
          <h2>What is still unknown</h2>
          <p>
            These are the open questions about {entity.name}. Nothing below has been
            answered by Rockstar, so this site does not answer it either.
          </p>
          <ul class="facts facts--open">
            {entity.notKnown.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}

      {entity.howWeKnow && (
        <>
          <h2>How this entry was built</h2>
          <p>{entity.howWeKnow}</p>
        </>
      )}

      <h2>Where this comes from</h2>
      <div class="plaque">
        {entity.sources.length > 0 ? (
          <ul>
            {entity.sources.map((url) => <li><a href={url} rel="nofollow noopener" target="_blank">{url}</a></li>)}
          </ul>
        ) : (
          <p>No published source. This entry is listed as unconfirmed.</p>
        )}
        <p class="plaque__meta">
          {TIER_LABEL[entity.sourceTier] ?? entity.sourceTier}.
          {entity.sourceDate && <> Checked {entity.sourceDate}.</>}
          {' '}Found a mistake? <a href="/contact">Tell us</a>.
        </p>
      </div>
    </div>
  </section>

  {shots.length > 0 && (
    <section class="band band--plaster">
      <div class="shell">
        <h2 style="margin-top:0">More pictures of {entity.name}</h2>
        <p class="lede">
          Every picture below was published by Rockstar Games. Each one names the
          file it came from and links back to the page that published it.
        </p>
        <Gallery shots={shots} name={entity.name} />
      </div>
    </section>
  )}

  {reported.length > 0 && (
    <section class="band band--plaster">
      <div class="shell prose">
        <h2 style="margin-top:0">Reported since this entry was written</h2>
        <p class="lede">
          Each line below records that an outlet published something about {entity.name}
          after this entry was made. The outlet's own words are quoted and linked. A
          report is not a confirmation, and the mark next to each one says which it is.
        </p>
        <ol class="since">
          {reported.map((item) => (
            <li class="since__item">
              {item.fact !== item.quote && <p class="since__fact">{item.fact}</p>}
              <p class="since__quote">"{item.quote}"</p>
              <p class="since__meta">
                <Mark status={statusForTier(item.tier)} />
                <a href={item.url} rel="nofollow noopener" target="_blank">{item.outlet}</a>
                {item.published && <span class="since__date">{item.published}</span>}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {entity.faq?.length > 0 && (
    <section class="band band--plaster">
      <div class="shell prose">
        <h2 style="margin-top:0">Common questions about {entity.name}</h2>
        <dl class="qa">
          {entity.faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="band">
      <div class="shell">
        <h2 style="margin-top:0">Related entries</h2>
        <ul class="tiles">
          {related.map((item) => <EntityTile entity={item} />)}
        </ul>
      </div>
    </section>
  )}
  <Ad placement="foot" />
</BaseLayout>
