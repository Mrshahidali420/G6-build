---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import EntityTile from '../components/EntityTile.astro'
import Icon from '../components/Icon.astro'
import Mark from '../components/Mark.astro'
import Countdown from '../components/Countdown.astro'
import Ad from '../components/Ad.astro'
import { SITE_NAME, SITE_TAGLINE, HUB_TYPES, ADSENSE_CLIENT, ADSENSE_SLOTS, canonical } from '../lib/site.mjs'
import gallery from '../data/gallery.json'
import mapPoints from '../data/map-points.json'
import cameras from '../data/camera-shots.json'
import trailerFeed from '../data/trailers.json'
import realPlaces from '../data/real-places.json'
import newswire from '../data/newswire.json'
import { pageEntities, entitiesOfType } from '../lib/entities.mjs'
import { imageFor } from '../lib/images.mjs'
import { GAME } from '../lib/schema.mjs'

const total = pageEntities.length
const confirmed = pageEntities.filter((entity) => entity.confirmedStatus === 'OFFICIAL_CONFIRMED').length
const description = `${total} Grand Theft Auto VI entries, ${confirmed} of them confirmed by Rockstar. Characters, cars, places, songs and brands, each one showing where the fact came from.`

// The answer pages carry the search traffic, so the home page links the top of
// them directly. order is set per page in its own frontmatter.
const allAnswers = (await getCollection('answers')).sort((a, b) => a.data.order - b.data.order)
const answers = allAnswers.slice(0, 12)

const newsCount = (await getCollection('news')).length
const trackerCount = (await getCollection('tracker')).length

// The three newest Rockstar posts, shown on the page rather than hidden behind
// a link. A front page that only links to its own sections looks like an empty
// shop; a front page that shows what is inside them does not.
const latest = [...newswire.posts]
  .sort((a, b) => String(b.date).localeCompare(String(a.date)))
  .slice(0, 3)

// The parts of the site that are not a catalogue hub. Each one prints what it
// actually holds, because a count is the honest way to say a section is worth
// opening. Every number here is read from the data file that builds the page.
// Every shot Rockstar has published, keyed by its slug, so a section card can
// carry a real picture instead of a coloured box. A section with no picture we
// may publish gets the terrazzo plate the rest of the site already uses for
// that case, which is a stated rule here and not an improvisation.
const shotBySlug = new Map(gallery.shots.map((shot) => [shot.slug, shot]))
const shotFor = (slug) => shotBySlug.get(slug) ?? null

// The eleven sections of the site that are not the catalogue. Each one carries
// its count as a number and a unit rather than as a sentence, because the card
// prints the number at a different size from the word next to it.
const records = [
  { slug: 'map', title: 'Map of Leonida', num: mapPoints.counts.kept, unit: 'places',
    shot: shotFor('mount-kalaga-1'),
    blurb: 'Every named place Rockstar has shown, on one pannable map.' },
  { slug: 'gallery', title: 'Official screenshots', num: gallery.counts.shots, unit: 'pictures',
    shot: shotFor('lucia-caminos-1'),
    blurb: 'Every still image Rockstar has published, credited and sorted.' },
  { slug: 'trailers', title: 'Trailer breakdown', num: trailerFeed.counts.confirmed, unit: 'details',
    shot: shotFor('jason-duval-1'),
    blurb: 'What each of the three trailers actually shows, shot by shot.' },
  { slug: 'trailer-locations', title: 'Where the trailers were filmed', num: cameras.counts.kept, unit: 'camera spots',
    shot: shotFor('port-gellhorn-1'),
    blurb: 'The spot in Leonida each official shot was filmed from, and the way the camera faced.' },
  { slug: 'real-places', title: 'The real Florida behind GTA 6', num: realPlaces.counts.kept, unit: 'real places',
    shot: shotFor('leonida-keys-1'),
    blurb: 'The actual Florida towns, roads and landmarks Leonida is built on.' },
  { slug: 'newswire', title: 'Rockstar Newswire', num: newswire.counts.total, unit: 'posts',
    shot: shotFor('ambrosia-1'),
    blurb: 'Rockstar’s own announcements, archived in order and checked daily.' },
  { slug: 'confirmed', title: 'Confirmed and rumoured', num: confirmed, unit: 'confirmed',
    shot: shotFor('grassrivers-1'),
    blurb: 'The line between what Rockstar said and what somebody else said.' },
  { slug: 'answers', title: 'Answers', num: allAnswers.length, unit: 'questions',
    shot: shotFor('real-dimez-1'),
    blurb: 'The questions people actually type, answered with a source on each one.' },
  { slug: 'news', title: 'News', num: newsCount, unit: 'dated entries',
    shot: shotFor('boobie-ike-1'),
    blurb: 'Every announcement with the date it was made.' },
  { slug: 'tracker', title: 'The claim record', num: trackerCount, unit: 'claims',
    shot: null,
    blurb: 'What people claimed about this game, and how it held up.' },
  { slug: 'numbers', title: 'GTA 6 by the numbers', num: null, unit: null,
    shot: null,
    blurb: 'The money, the wait and the search interest, drawn from public data.' },
]

const updated = (await getCollection('answers'))
  .map((page) => page.data.updated)
  .sort()
  .at(-1)

// The front page used to show one entry per section, which made a record of a
// hundred entries look like a record of nine. Every section now gets its own
// strip, so the whole shape of the site is visible from the front door.
//
// Inside a strip, entries that have a real picture come first, then the ones
// Rockstar has confirmed. The strongest thing we hold in a section is the first
// thing a reader meets in it.
// The proof strip under the hero. Four numbers, all of them read off the data
// the site is built from, so none of them can drift from what the pages say.
// The source count is distinct publisher domains, not a total of citations:
// citing one site twice is not two sources.
const sourceSites = new Set(
  pageEntities
    .flatMap((entity) => entity.sources ?? [])
    .map((url) => {
      try {
        return new URL(String(url)).hostname.replace(/^www\./, '')
      } catch {
        return null
      }
    })
    .filter(Boolean),
).size

const checkedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    }).replace('Sept', 'Sep')
  : 'Today'

// An answer carries a tag saying where its evidence came from, because that is
// the thing a reader wants to know before they click. It is read off the source
// list the page already prints, so the tag can never disagree with the page.
const answerTag = (page) =>
  (page.data.sources ?? []).some((source) => String(source.url).includes('rockstargames.com'))
    ? { label: 'Rockstar source', kind: 'yes' }
    : { label: 'Reported', kind: 'no' }

const PER_SECTION = 4

const rank = (entity) =>
  (imageFor(entity.slug) ? 0 : 2) + (entity.confirmedStatus === 'OFFICIAL_CONFIRMED' ? 0 : 1)

const sections = HUB_TYPES.map((hub) => {
  const all = entitiesOfType(hub.type)
  return {
    hub,
    total: all.length,
    label: hub.title.replace('GTA 6 ', ''),
    entries: [...all].sort((a, b) => rank(a) - rank(b)).slice(0, PER_SECTION),
  }
}).filter((section) => section.entries.length > 0)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    GAME,
    {
      '@type': 'WebSite',
      '@id': `${canonical('/')}#website`,
      name: SITE_NAME,
      url: canonical('/'),
      description,
    },
  ],
}

// The ad band only exists once there is an ad to put in it. An empty plaster
// strip between two bands is a hole in the page, not a placeholder.
const showAd = Boolean(ADSENSE_CLIENT && ADSENSE_SLOTS.index)
---
<BaseLayout title={SITE_TAGLINE} description={description} path="/" updated={updated} jsonLd={jsonLd}>
  <!--
    The masthead. A plaster ground, not a glazed band: the front page opens on
    a claim and the evidence for it, and a dark slab behind the whole thing
    made both read as decoration. The glaze is spent instead on the one panel
    that holds Rockstar's own figures, so the eye goes to the facts.
  -->
  <section class="band band--plaster hero-band">
    <div class="shell">
      <div class="hero__split">
        <div class="hero__lead">
          <p class="hero__eyebrow">The record</p>
          <h1 class="hero__title">Every confirmed Grand Theft Auto VI fact, with its source</h1>
          <p class="lede">
            {total} entries. {confirmed} of them confirmed by Rockstar itself. The rest
            say plainly who reported them, and when.
          </p>
          <Mark status="OFFICIAL_CONFIRMED" as="stamp" label="Confirmed by Rockstar" />

          <div class="btns hero__btns">
            <a class="btn" href="/news">Every dated announcement <Icon name="arrow" size={16} /></a>
            <a class="btn btn--quiet" href="/about">How the data is checked</a>
          </div>
        </div>

        <div class="hero__facts">
          <div class="hspec">
            <p class="hspec__h">Release specification</p>
            <div class="hspec__row">
              <span class="hspec__k">Release date</span>
              <span class="hspec__v hspec__v--big"><a href="/gta-6-countdown">19 November 2026</a></span>
            </div>
            <div class="hspec__row">
              <span class="hspec__k">Platforms</span>
              <span class="hspec__v">PlayStation 5, Xbox Series X and Series S</span>
            </div>
            <div class="hspec__row">
              <span class="hspec__k">Price</span>
              <span class="hspec__v">79.99 USD standard, 99.99 USD ultimate</span>
            </div>
            <div class="hspec__row">
              <span class="hspec__k">Source</span>
              <span class="hspec__v">
                <a href="/gta-6-release-date">Rockstar Newswire, checked on the release date page</a>
                <span class="hspec__mark">Official</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero__count">
        <Countdown flat={true} />
        <p class="hero__launch">
          Launch week, unlock times and "is GTA 6 out yet?" in one place:
          <a href="/gta-6-launch">GTA 6 launch day hub</a>.
        </p>
      </div>
    </div>
  </section>

  <!--
    The proof strip. Four numbers on the seam under the masthead, each one read
    off the data the site is built from. It sits here because the headline above
    it makes a claim about size and honesty, and this is the cheapest place to
    show the claim is measurable.
  -->
  <section class="ledger" aria-label="The size of the record">
    <div class="shell">
      <div class="ledger__grid">
        <div class="ledger__cell">
          <b>{total.toLocaleString('en-GB')}</b>
          <span>Entries on file</span>
        </div>
        <div class="ledger__cell">
          <b>{confirmed.toLocaleString('en-GB')}</b>
          <span>Confirmed by Rockstar</span>
        </div>
        <div class="ledger__cell">
          <b>{sourceSites.toLocaleString('en-GB')}</b>
          <span>Named sources cited</span>
        </div>
        <div class="ledger__cell">
          <b>{checkedLabel}</b>
          <span>Last checked</span>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--plaster">
    <div class="shell">
      <h2>What the marks mean</h2>
      <p class="lede">
        Grand Theft Auto VI is not out yet, and most of what is written about it
        online is a guess. Every entry here carries one of these four marks, so
        you can see who said a thing before you decide to believe it.
      </p>
      <dl class="ladder">
        <dt><Mark status="OFFICIAL_CONFIRMED" /></dt>
        <dd>Rockstar published it: a trailer, a Newswire post, or the game's own site.</dd>
        <dt><Mark status="PRESS_REPORTED" /></dt>
        <dd>A named news outlet reported it, and the report is linked on the entry.</dd>
        <dt><Mark status="COMMUNITY_IDENTIFIED" /></dt>
        <dd>Players spotted it in published footage. Plausible, but nobody official said it.</dd>
        <dt><Mark status="UNCONFIRMED" /></dt>
        <dd>Nothing reliable backs it yet. It stays on the site only with this mark on it.</dd>
      </dl>
      <div class="btns">
        <a class="btn btn--quiet" href="/about">How the data is checked</a>
      </div>
    </div>
  </section>

  <!--
    The eleven sections, as picture cards. A ruled text index was tried first
    and threw away the one thing the front page has that a list does not: every
    section of this site looks like something. The picture is the card, the
    count rides on a glazed tab over it, and a section with no picture we may
    publish gets the terrazzo plate instead of an empty grey box.
  -->
  <section class="band">
    <div class="shell">
      <h2>The record, section by section</h2>
      <p class="lede">
        The catalogue is only half the site. These are the other eleven parts of
        it, and what each one holds today.
      </p>
      <ul class="cards">
        {records.map((record) => (
          <li class="card">
            <a href={`/${record.slug}`}>
              <span class="card__shot">
                {record.shot ? (
                  <img
                    src={record.shot.src}
                    srcset={record.shot.srcset}
                    sizes="(max-width: 640px) 100vw, 300px"
                    alt={`${record.shot.title}, an official Rockstar screenshot`}
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="400"
                  />
                ) : (
                  <span class="card__plate"><span>No published photo</span></span>
                )}
                {record.num !== null && (
                  <span class="card__tab">
                    <b>{record.num.toLocaleString('en-GB')}</b>
                    <small>{record.unit}</small>
                  </span>
                )}
              </span>
              <span class="card__body">
                <span class="card__name">{record.title}</span>
                <span class="card__sub">{record.blurb}</span>
                <span class="card__credit">{record.shot ? 'Rockstar Games' : 'Terrazzo plate'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!--
    The questions, each with a tag saying where its evidence comes from. The tag
    is read off the source list the answer page already prints, so it cannot
    drift from the page it points at.
  -->
  <section class="band band--plaster">
    <div class="shell">
      <h2>The questions people ask most</h2>
      <p class="lede">
        Every answer names the sources it came from. The tag says whether
        Rockstar itself is one of them, before you click.
      </p>
      <ul class="qs">
        {answers.map((page) => (
          <li class="qs__row">
            <a class="qs__q" href={`/${page.id}`}>{page.data.title}</a>
            <span class="qs__meta">
              <span class="qs__date">Checked {page.data.updated}</span>
              <span class:list={['qs__tag', `qs__tag--${answerTag(page).kind}`]}>{answerTag(page).label}</span>
            </span>
          </li>
        ))}
      </ul>
      <div class="btns">
        <a class="btn" href="/answers">Every question we answer <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <h2>Browse the record</h2>
      <p class="lede">
        Every section of the site, with the strongest entries in each one. Entries
        without a picture we may publish carry a terrazzo plate in their section's
        colour, so you can tell a car from a song before you read.
      </p>

      {sections.map((section) => (
        <div class="cat">
          <div class="cat__head">
            <h3 class="cat__title"><a href={`/${section.hub.slug}`}>{section.label}</a></h3>
            <a class="cat__more" href={`/${section.hub.slug}`}>
              All {section.total} {section.total === 1 ? 'entry' : 'entries'}
              <Icon name="arrow" size={14} />
            </a>
          </div>
          <ul class="tiles">
            {section.entries.map((entity) => <EntityTile entity={entity} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {showAd && (
    <section class="band band--plaster">
      <div class="shell">
        <Ad placement="index" />
      </div>
    </section>
  )}

  <!--
    Rockstar's own words, on Rockstar's own ground. The band is glazed because
    everything in it was written by them and not by this site, and the date
    gets its own column so the three posts read as a dated record rather than
    as three headlines.
  -->
  <section class="band band--glaze">
    <div class="shell">
      <h2>The last thing Rockstar said</h2>
      <p class="lede">
        Straight from Rockstar’s own Newswire. This list is rebuilt every day,
        so the top entry is the newest thing Rockstar has published.
      </p>
      <ul class="wire">
        {latest.map((post, index) => (
          <li class="wire__item">
            <p class="wire__date">
              {post.date}
              {index === 0 && <span class="wire__new">Newest</span>}
            </p>
            <div class="wire__body">
              <h3 class="wire__title"><a href="/newswire">{post.title}</a></h3>
              {post.subtitle && <p class="wire__sub">{post.subtitle}</p>}
            </div>
          </li>
        ))}
      </ul>
      <div class="btns">
        <a class="btn" href="/newswire">The whole Newswire archive <Icon name="arrow" size={16} /></a>
        <a class="btn btn--quiet" href="/gallery">Official screenshots</a>
        <a class="btn btn--quiet" href="/trailers">Trailer breakdown</a>
      </div>
    </div>
  </section>

  <!--
    The only numbered thing on the page. Numbering is information here and
    nowhere else: an entry really does go through these four states in this
    order, and a reader who knows the order can read every mark on the site.
  -->
  <section class="band">
    <div class="shell">
      <h2>How this site works</h2>
      <ol class="steps">
        <li class="step">
          <p class="step__n">Step 1</p>
          <h3 class="step__h">Found</h3>
          <p class="step__p">
            A thing shows up in a trailer, a screenshot, a Newswire post or a
            press report. Nothing enters the record from a rumour alone.
          </p>
        </li>
        <li class="step">
          <p class="step__n">Step 2</p>
          <h3 class="step__h">Sourced</h3>
          <p class="step__p">
            The entry records where it came from and links it. If no source can
            be named, the entry is not written.
          </p>
        </li>
        <li class="step">
          <p class="step__n">Step 3</p>
          <h3 class="step__h">Marked</h3>
          <p class="step__p">
            One of four marks goes on it, so a Rockstar fact never looks the
            same as something a player spotted in a frame.
          </p>
        </li>
        <li class="step">
          <p class="step__n">Step 4</p>
          <h3 class="step__h">Dated</h3>
          <p class="step__p">
            The page prints the day it was last checked. When Rockstar says more,
            the entry changes and the date moves.
          </p>
        </li>
      </ol>

      <div class="prose">
        <p>
          If nothing reliable says a thing, it is not on the site. That rule costs
          the site pages. There is no mission list here, no weapon
          list, no cheat codes and no map coordinates, because Rockstar has published
          none of that. Sites that carry those lists today made them up. When the game
          ships on 19 November 2026 those pages get written from the real thing.
        </p>
        <p>
          Nothing on this site is affiliated with Rockstar Games or Take-Two
          Interactive. It is an independent record of what has been published.
        </p>
        <p>
          <a href="/news">Every dated announcement so far</a> ·
          <a href="/confirmed">What Rockstar has confirmed</a> ·
          <a href="/tracker">The claim record</a> ·
          <a href="/gta-6-release-date">The release date and its history</a> ·
          <a href="/gta-6-cheats">Why there are no cheats yet</a> ·
          <a href="/best-cars-in-gta-6">The confirmed cars</a> ·
          <a href="/gta-6-preparation-guide">Getting ready for launch</a> ·
          <a href="/about">How the data is checked</a> ·
          <a href="/search">Search every page</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The proof strip. One glazed band of four figures on the seam under the
     masthead. The hairlines between cells are the grid gap showing through a
     lighter background, so there is no border to double up at the ends. */
  .ledger { background: var(--glaze); border-bottom: 1px solid var(--glaze-deep); }
  .ledger__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: rgb(185 214 205 / 0.25);
  }
  .ledger__cell {
    background: var(--glaze);
    padding: 16px clamp(10px, 1.6vw, 20px) 15px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .ledger__cell b {
    font-family: var(--display);
    font-stretch: 118%;
    font-weight: 800;
    font-size: clamp(1.3rem, 0.9rem + 1.3vw, 1.8rem);
    line-height: 1;
    color: var(--on-glaze);
    font-variant-numeric: tabular-nums;
  }
  .ledger__cell span {
    font-family: var(--ui);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-glaze-2);
  }
  @media (max-width: 900px) {
    .ledger__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* The eleven non-catalogue sections, as picture cards. The picture is the
     card: every section of this site looks like something, and a text index
     threw that away. The count rides on a glazed tab over the bottom left of
     the picture, so the number a reader wants sits on the thing they are
     already looking at. */
  .cards {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  .card {
    display: flex;
    background: var(--plaster);
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    overflow: hidden;
  }
  .card > a {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }
  .card:hover .card__name { text-decoration: underline; }

  .card__shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--chip);
    border-bottom: 3px solid var(--brass);
    overflow: hidden;
  }
  .card__shot img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    display: block;
  }

  /* The poured terrazzo plate, for a section with no picture we may publish.
     The site already uses this rather than an empty grey box, and says so. */
  .card__plate {
    position: absolute;
    inset: 0;
    background-color: var(--chip);
    background-image:
      radial-gradient(circle at 18% 28%, var(--brass) 0 3px, transparent 3px),
      radial-gradient(circle at 63% 17%, var(--glaze) 0 5px, transparent 5px),
      radial-gradient(circle at 82% 61%, var(--brass) 0 4px, transparent 4px),
      radial-gradient(circle at 34% 74%, var(--glaze-lift) 0 6px, transparent 6px),
      radial-gradient(circle at 51% 46%, var(--clay) 0 3px, transparent 3px),
      radial-gradient(circle at 8% 82%, var(--glaze) 0 4px, transparent 4px),
      radial-gradient(circle at 92% 22%, var(--clay) 0 2px, transparent 2px),
      radial-gradient(circle at 72% 88%, var(--brass) 0 3px, transparent 3px);
    display: grid;
    place-items: center;
  }
  .card__plate span {
    font-family: var(--ui);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: var(--stone);
    padding: 5px 10px;
    border: 1px solid var(--line-strong);
  }

  .card__tab {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 7px;
    padding: 7px 13px;
    background: var(--glaze-deep);
    color: var(--on-glaze);
    border-top: 1px solid var(--brass);
    border-right: 1px solid var(--brass);
    font-variant-numeric: tabular-nums;
  }
  .card__tab b {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.12rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .card__tab small {
    font-family: var(--ui);
    font-size: 0.58rem;
    font-weight: 700;
