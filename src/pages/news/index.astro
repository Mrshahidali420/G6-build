---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Mark from '../../components/Mark.astro'
import { SITE_NAME, SITE_URL, canonical } from '../../lib/site.mjs'
import { GAME } from '../../lib/schema.mjs'

const posts = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date))

const path = '/news'
const title = 'GTA 6 News'
const description = `Every dated Grand Theft Auto VI announcement, newest first, each one with the source it came from. ${posts.length} entries plus the dates still ahead.`

// Dates that have not happened yet. These are announced, not guessed.
const upcoming = [
  {
    date: '12 November 2026',
    what: 'Preload opens for digital pre-orders, one week before launch.',
    status: 'PRESS_REPORTED',
  },
  {
    date: '19 November 2026',
    what: 'Grand Theft Auto VI launches on PS5 and Xbox Series X|S, worldwide.',
    status: 'OFFICIAL_CONFIRMED',
  },
  {
    date: '20 November 2026',
    what: 'Last day the Vintage Vice City Pack comes free with a pre-order.',
    status: 'OFFICIAL_CONFIRMED',
  },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonical(path),
  url: canonical(path),
  name: title,
  description,
  about: GAME,
  isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: SITE_NAME, url: SITE_URL },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: canonical(`/news/${post.id}`),
    })),
  },
}

const human = (value) =>
  new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  })
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="band band--glaze">
    <div class="shell">
      <p class="crumb" style="color:var(--on-glaze-2)">
        <a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> / News
      </p>
      <h1>GTA 6 news</h1>
      <p class="lede">
        Every announcement that actually happened, with the date it happened and a
        link to where it came from. No rumours, no leaks, no reposted guesses.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <h2 style="margin-top:0">What has happened</h2>
      <ul class="dated">
        {posts.map((post) => (
          <li>
            <div class="dated__row">
              <span class="dated__date">{human(post.data.date)}</span>
              <Mark status={post.data.tier === 'TIER_1_OFFICIAL' ? 'OFFICIAL_CONFIRMED' : 'PRESS_REPORTED'} />
            </div>
            <a class="dated__title" href={`/news/${post.id}`}>{post.data.title}</a>
            <p style="margin-top:6px">{post.data.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--plaster">
    <div class="shell">
      <h2 style="margin-top:0">What is still ahead</h2>
      <p class="lede">These dates are announced, not predicted. Nothing on this list is a guess.</p>
      <ul class="dated">
        {upcoming.map((item) => (
          <li>
            <div class="dated__row">
              <span class="dated__date">{item.date}</span>
              <Mark status={item.status} />
            </div>
            <p>{item.what}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="shell prose">
      <h2 style="margin-top:0">What you will not find here</h2>
      <p>
        No leak roundups. No "everything we know" posts that get rewritten every
        week. No third trailer date, because Rockstar has not given one. If a thing
        is not dated and sourced, it does not go on this page.
      </p>
      <p>
        For the facts that do not change day to day, start at
        <a href="/gta-6-release-date">the release date page</a> or
        <a href="/gta-6-price">the price page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
