---
// The real Florida places that GTA 6 locations are built from.
//
// Vice City is Miami. Everyone knows that much. What is less known is that the
// game reaches a long way past Miami: Port Gellhorn is the Panama City strip in
// the panhandle, Ambrosia is the sugar town of Clewiston, Hamlet is Homestead.
// This page is the row by row version of that, one in-game place to one real
// address, from the GTADB community map.
//
// The important discipline here is what this page does NOT claim. Rockstar has
// never published a single one of these pairings. A real place is an analogue.
// It tells you where the art team looked. It does not settle anything about the
// game, and the page says so in plain words rather than in small print.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_NAME, SITE_URL, canonical } from '../lib/site.mjs'
import { GAME } from '../lib/schema.mjs'
import feed from '../data/real-places.json'

const { counts, areas } = feed
const rows = areas.flatMap((area) => area.items)

/** Every real town in the set, busiest first. */
const towns = (() => {
  const tally = new Map()
  for (const row of rows) {
    if (!row.realCity) continue
    tally.set(row.realCity, (tally.get(row.realCity) || 0) + 1)
  }
  return [...tally.entries()]
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
})()

const miami = towns.filter((town) => /^Miami/.test(town.name)).reduce((sum, town) => sum + town.count, 0)
const demolished = rows.filter((row) => row.gone).length

/** An anchor for one in-game area, so the contents list can jump to it. */
const anchor = (name) =>
  `area-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`

const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
]
function longDate(iso) {
  const [year, month, day] = String(iso || '').split('-')
  if (!year) return iso
  return `${Number(day)} ${MONTHS[Number(month) - 1]} ${year}`
}

const path = '/real-places'
const title = 'GTA 6 locations and the real Florida places behind them'
const description = `Community mappers have matched ${counts.kept} named places in Grand Theft Auto VI to real addresses in Florida, across ${counts.areas} areas of Leonida. This is the full list, and what it is honestly worth.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': canonical(path),
  url: canonical(path),
  name: title,
  description,
  about: GAME,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isBasedOn: [feed.sourceUrl, feed.sourceRepo],
  creator: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'In-game place name' },
    { '@type': 'PropertyValue', name: 'In-game area' },
    { '@type': 'PropertyValue', name: 'Real-world address in Florida' },
  ],
  spatialCoverage: { '@type': 'Place', name: 'Florida, United States' },
}
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="band band--glaze">
    <div class="shell">
      <p class="crumb" style="color:var(--on-glaze-2)">
        <a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> / Real places
      </p>
      <h1 style="max-width:22ch">The real Florida behind GTA 6</h1>
      <p class="lede">{description}</p>
      <dl class="tally">
        <div><dt>Places matched</dt><dd>{counts.kept}</dd></div>
        <div><dt>Areas of Leonida</dt><dd>{counts.areas}</dd></div>
        <div><dt>Real towns</dt><dd>{towns.length}</dd></div>
        <div><dt>Linked to a page here</dt><dd>{counts.linked}</dd></div>
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <div class="prose">
        <h2>Vice City is Miami, and Leonida is the rest of Florida</h2>
        <p>
          The first part is old news. Vice City has stood in for Miami since
          Grand Theft Auto: Vice City, which came out in 2002 and was set in
          1986. The second part is what this list makes plain. Leonida is a whole state,
          and the art team went all over the real one to build it.
        </p>
        <p>
          {miami} of the {counts.kept} matches below are in Miami or Miami
          Beach. The rest are not. Port Gellhorn is the highway strip through
          Panama City, up on the panhandle, about 600 miles from South Beach.
          <a href="/locations/ambrosia">Ambrosia in GTA 6</a> is based on Clewiston, a sugar town on Lake Okeechobee. Hamlet is
          Homestead. Key Lento is Key Largo and Islamorada. One prison in the
          set is Raiford, in the north of the state.
        </p>
        <p>
          So the map is not a copy of Miami with a few extra fields around it.
          It is a set of real Florida towns, each one with its own look, pulled
          together into one place.
        </p>

        <h2>What this page does not say</h2>
        <p>
          Rockstar has never published any of these pairings. Not one. Every row
          below is community work: people watched the official videos, looked at
          the buildings, and found the real one.
        </p>
        <p>
          That makes a real address useful and it does not make it proof. It
          tells you where somebody looked for a reference. It does not tell you
          the name of the place in the game, what happens there, or whether it
          is still in the game at all. The pages on this site that do carry
          claims about the game say where those claims came from, and this page
          is not one of those sources.
        </p>
        <p>
          The list also has its own doubts written into it. {counts.supported}
          of the {counts.kept} rows are marked supported by the mappers, which
          means somebody checked the work. The rest are best guesses and are
          marked <strong>unsure</strong> below. {demolished} of the real places
          have since been knocked down, and those are marked <strong>gone</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--stone">
    <div class="shell">
      <h2 class="head">The real towns, busiest first</h2>
      <p class="head__sub">
        How many of the {counts.kept} matched places sit in each real Florida
        town. A town with one entry is usually one building that stood out.
      </p>
      <ul class="towns">
        {towns.map((town) => (
          <li class="towns__item">
            <span class="towns__name">{town.name}</span>
            <span class="towns__bar" style={`width:${Math.max(3, (town.count / towns[0].count) * 100)}%`}></span>
            <span class="towns__n">{town.count}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <h2 class="head">Jump to an area</h2>
      <p class="head__sub">{counts.areas} areas of Leonida, largest first.</p>
      <ul class="jump">
        {areas.map((area) => (
          <li><a href={`#${anchor(area.name)}`}>{area.name} <span>{area.count}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  {areas.map((area, index) => (
    <section class={`band ${index % 2 === 0 ? 'band--stone' : ''}`} id={anchor(area.name)}>
      <div class="shell">
        <header class="area__head">
          <h2 class="area__title">{area.name}</h2>
          <p class="area__sub">
            {area.count} {area.count === 1 ? 'place' : 'places'} matched.
            {area.cities.length > 0 && <span>{` Mostly ${area.cities[0].name}${area.cities.length > 1 ? `, with ${area.cities.slice(1, 3).map((city) => city.name).join(' and ')}` : ''}.`}</span>}
          </p>
        </header>

        <ul class="pairs">
          {area.items.map((row) => (
            <li class="pairs__item">
              <div class="pairs__game">
                <span class="kind">{row.kind}</span>
                {row.url
                  ? <a class="pairs__name" href={row.url}>{row.name}</a>
                  : <span class="pairs__name">{row.name}</span>}
                {row.doubt && <span class="flag flag--doubt">unsure</span>}
              </div>
              <div class="pairs__real">
                <p class="pairs__realname">
                  {row.real}
                  {row.gone && <span class="flag flag--gone">gone</span>}
                </p>
                {row.realWhere && <p class="pairs__where">{row.realWhere}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="band">
    <div class="shell">
      <div class="prose">
        <h2>Where this list comes from</h2>
        <p>
          The pairings are from the
          <a href={feed.sourceUrl} rel="nofollow noopener">GTADB community map</a>
          of Grand Theft Auto VI, built in the open at
          <a href={feed.sourceRepo} rel="nofollow noopener">rolux/gtadb.org</a>
          and shared under a CC BY 4.0 licence. This site reads the revision
          pinned by the
          <a href={feed.via} rel="nofollow noopener">gta6-leonida-atlas</a>
          project, revision {String(feed.sourceRevision || '').slice(0, 7)}.
          The full map holds {counts.records} records. Most of them are a shape
          on a map with no name and no real address, and those are left out
          here. What is left is the {counts.kept} rows that a reader can check.
        </p>
        <p>
          Each in-game name is then matched against the record already on this
          site. {counts.linked} of them found a page and became a link. The rest
          list without a link, which usually means this site has no page for the
          place yet.
        </p>
        <p>
          No map image, no screenshot and no photograph is copied here. The list
          is names and addresses. The last rebuild was {longDate(feed.built)}.
        </p>

        <h2>How sure is any of this</h2>
        <p>
          The atlas project sets out an order of evidence and this site keeps
          the same one. Official Rockstar media comes first, and only that can
          confirm a thing exists in the game. The community map comes second,
          and it can support where a thing sits. A real Florida address comes
          third, and it is background only.
        </p>
        <p>
          The two pages on this site that carry only Rockstar material are the
          <a href="/newswire">Newswire record</a> and the
          <a href="/trailers">trailer index</a>. Read those for what has been
          confirmed. Read this one for where the game was looking.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tally { display: flex; flex-wrap: wrap; gap: 10px 36px; margin: 22px 0 0; }
  .tally div { margin: 0; }
  .tally dt {
    font: 600 11px/1 var(--ui); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--on-glaze-2); margin: 0 0 6px;
  }
  .tally dd { font: 700 22px/1 var(--display); color: var(--on-glaze); margin: 0; }

  .head { font: 700 24px/1.2 var(--display); margin: 0 0 6px; color: var(--ink); }
  .head__sub { margin: 0 0 20px; max-width: var(--prose); font: 400 15px/1.6 var(--body); color: var(--ink-2); }

  .towns { list-style: none; margin: 0; padding: 0; max-width: 680px; }
  .towns__item {
    display: grid; grid-template-columns: 170px minmax(0, 1fr) 34px;
    align-items: center; gap: 12px; padding: 5px 0;
  }
  .towns__name { font: 400 15px/1.3 var(--body); color: var(--ink); }
  .towns__bar { height: 9px; background: var(--glaze); border-radius: var(--r); }
  .towns__n {
    font: 600 13px/1 var(--ui); color: var(--ink-2); text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .jump { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a {
    display: inline-block; padding: 6px 10px; background: var(--chip);
    border-radius: var(--r); font: 600 13px/1 var(--ui); color: var(--ink);
    text-decoration: none;
  }
  .jump a:hover { background: var(--glaze-tint); color: var(--glaze-deep); }
  .jump a span { color: var(--ink-2); font-weight: 400; margin-left: 4px; }

  .area__head { margin: 0 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--line-strong); }
  .area__title { font: 700 24px/1.2 var(--display); margin: 0 0 4px; color: var(--ink); }
  .area__sub { margin: 0; font: 400 15px/1.5 var(--body); color: var(--ink-2); }

  .pairs { list-style: none; margin: 0; padding: 0; }
  .pairs__item {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4px 32px; padding: 11px 0; border-bottom: 1px solid var(--line);
  }
  .pairs__item:last-child { border-bottom: 0; }
  .pairs__game { min-width: 0; }
  .pairs__name { font: 600 16px/1.5 var(--body); color: var(--ink); }
  a.pairs__name { text-decoration: none; border-bottom: 2px solid var(--glaze-tint); }
  a.pairs__name:hover { border-bottom-color: var(--glaze); }
  .pairs__real { min-width: 0; }
  .pairs__realname { margin: 0; font: 400 16px/1.5 var(--body); color: var(--ink); }
  .pairs__where { margin: 1px 0 0; font: 400 14px/1.5 var(--body); color: var(--ink-2); }

  .kind {
    display: inline-block; margin-right: 9px; padding: 3px 7px;
    font: 600 10px/1 var(--ui); letter-spacing: 0.08em; text-transform: uppercase;
    border-radius: var(--r); background: var(--chip); color: var(--ink-2);
    vertical-align: 2px;
  }
  .flag {
    margin-left: 9px; font: 600 10px/1 var(--ui); letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .flag--doubt { color: var(--clay); }
  .flag--gone { color: var(--brass-ink); }

  @media (max-width: 720px) {
    .pairs__item { grid-template-columns: 1fr; gap: 2px; }
    .pairs__real { padding-left: 0; }
    .towns__item { grid-template-columns: 120px minmax(0, 1fr) 30px; gap: 8px; }
  }
</style>
