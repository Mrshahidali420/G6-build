---
import BaseLayout from '../layouts/BaseLayout.astro'
import { pageEntities } from '../lib/entities.mjs'

// Pagefind builds its own index from dist/ after astro build, so this page is
// empty at build time and fills itself in the browser. It is noindex because a
// search box is not a page Google should rank.
const total = pageEntities.length
---
<BaseLayout
  title="Search"
  description="Search every confirmed Grand Theft Auto VI fact on this site: characters, cars, places, songs, shops, brands and gameplay, each one with its source."
  path="/search"
  noindex={true}
>
  <section class="band band--glaze">
    <div class="shell">
      <p class="crumb" style="color:var(--on-glaze-2)"><a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> / Search</p>
    <h1>Search</h1>
      <p class="lede">
    Type a name. {total} pages are searchable, and every result opens a page that
    shows where its facts came from.
  </p>
    </div>
  </section>

  <section class="band">
    <div class="shell prose">

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search"></div>
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false })
    })
  </script>

  <noscript>
    <p>Search needs JavaScript. Without it, use the sections in the footer.</p>
  </noscript>
    </div>
  </section>
</BaseLayout>
