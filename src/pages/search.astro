---
import BaseLayout from '../layouts/BaseLayout.astro'
import { pageEntities } from '../lib/entities.mjs'

// Pagefind builds its own index from dist/ after astro build, so this page is
// empty at build time and fills itself in the browser. It is noindex because a
// search box is not a page Google should rank.
const total = pageEntities.length
---
<BaseLayout
  title="Search"
  description="Search every confirmed Grand Theft Auto VI fact on this site: characters, cars, places, songs, shops, brands and gameplay, each one with its source."
  path="/search"
  noindex={true}
>
  <section class="band band--glaze">
    <div class="shell">
      <p class="crumb" style="color:var(--on-glaze-2)"><a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> / Search</p>
    <h1>Search</h1>
      <p class="lede">
    Type a name. {total} pages are searchable, and every result opens a page that
    shows where its facts came from.
  </p>
    </div>
  </section>

  <section class="band">
    <div class="shell prose">

  <!--
    The stylesheet and the script are both fetched as soon as the parser reaches
    them, and the index files are preloaded next to them, so nothing waits for
    the rest of the page. Pagefind writes these files after astro build, which
    is why they are referenced by path and not imported.
  -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <link rel="preload" href="/pagefind/pagefind.js" as="script" crossorigin />
  <div id="search"></div>
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    // Run the moment the script is parsed rather than on DOMContentLoaded. The
    // mount point is directly above this tag, so it already exists, and waiting
    // for the whole document added a delay the visitor could feel.
    //
    // A query in the URL is run straight away. That is what makes the header
    // form feel instant: the visitor types once, presses enter, and the results
    // page arrives with the search already done.
    (function () {
      var query = new URLSearchParams(window.location.search).get('q') || ''
      var ui = new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        autofocus: !query,
      })
      if (query) ui.triggerSearch(query)
    })()
  </script>

  <noscript>
    <p>Search needs JavaScript. Without it, use the sections in the footer.</p>
  </noscript>
    </div>
  </section>
</BaseLayout>
