---
// One official GTA 6 video, shot by shot.
//
// /trailers lists what all three videos show on one long page. This page takes
// one video on its own and puts three records side by side for it: the
// timestamped moments (trailers.json), the songs heard in it (the song rows),
// and the spots its shots were filmed from (camera-shots.json). A moment links
// to an entity page only when the source data already links it. Everything
// is read through src/lib/shots.mjs, the same helper the entity pages use for
// their "Seen in Trailer 2 at 1:42" line.
import BaseLayout from '../../layouts/BaseLayout.astro'
import Ad from '../../components/Ad.astro'
import { SITE_NAME, SITE_URL, canonical } from '../../lib/site.mjs'
import { GAME } from '../../lib/schema.mjs'
import {
  videos, shotsFor, camerasFor, cameraGroupUrl, trailerUrl, shortTitle, youtubeAt,
} from '../../lib/shots.mjs'
import { songsOn, NOT_LOGGED } from '../../lib/soundtrack.mjs'

export function getStaticPaths() {
  return videos.map((video, index) => ({
    params: { video: video.id },
    props: { video, prev: videos[index - 1] ?? null, next: videos[index + 1] ?? null },
  }))
}

const { video, prev, next } = Astro.props

const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
]
function longDate(iso) {
  const [year, month, day] = String(iso || '').split('-')
  if (!year) return iso
  return `${Number(day)} ${MONTHS[Number(month) - 1]} ${year}`
}

const TYPE_LABEL = {
  location: 'Place',
  character: 'Person',
  vehicle: 'Vehicle',
  weapon: 'Weapon',
  wildlife: 'Animal',
  audio: 'Music',
  reveal: 'Detail',
}

// Cut at a space, never through a word.
function trim(text, limit) {
  const value = String(text ?? '')
  if (value.length <= limit) return value
  const cut = value.slice(0, limit)
  const space = cut.lastIndexOf(' ')
  return `${(space > 40 ? cut.slice(0, space) : cut).replace(/[.,;:]$/, '')}...`
}

const shots = shotsFor(video.id)
const linked = shots.filter((shot) => shot.href)
const linkedPages = new Set(linked.map((shot) => shot.href)).size
const confirmed = shots.filter((shot) => shot.confirmed).length
const cameras = camerasFor(video.id)
const songs = songsOn(video.id)
const name = shortTitle(video.id).replace(/^the /, '')
const Name = name.charAt(0).toUpperCase() + name.slice(1)

const path = trailerUrl(video.id)
const title = `GTA 6 ${Name} shot by shot: ${shots.length} moments`
const description = `Every logged moment of Rockstar's GTA 6 ${Name} (${video.runtime}, ${longDate(video.publishedAt)}) with its timestamp: ${shots.length} moments, ${linked.length} linked to ${linkedPages} pages here.`

const clipEnd = (index) => shots[index + 1]?.seconds ?? video.durationSec
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    '@id': `${canonical(path)}#video`,
    name: video.title,
    description,
    uploadDate: video.publishedAt,
    duration: `PT${Math.floor(video.durationSec / 60)}M${video.durationSec % 60}S`,
    thumbnailUrl: `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`,
    embedUrl: `https://www.youtube.com/embed/${video.youtubeId}`,
    url: video.url,
    about: GAME,
    publisher: { '@type': 'Organization', name: 'Rockstar Games', url: 'https://www.rockstargames.com' },
    hasPart: shots.map((shot, index) => ({
      '@type': 'Clip',
      name: shot.name,
      startOffset: shot.seconds,
      endOffset: Math.max(clipEnd(index), shot.seconds + 1),
      url: shot.youtube,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical(path),
    url: canonical(path),
    name: title,
    description,
    about: { '@id': `${canonical(path)}#video` },
    isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: canonical('/') },
        { '@type': 'ListItem', position: 2, name: 'Trailers', item: canonical('/trailers') },
        { '@type': 'ListItem', position: 3, name: Name, item: canonical(path) },
      ],
    },
  },
]
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="band band--glaze">
    <div class="shell">
      <p class="crumb" style="color:var(--on-glaze-2)">
        <a href="/" style="color:var(--on-glaze-2)">GTA 6 Record</a> /
        <a href="/trailers" style="color:var(--on-glaze-2)">Trailers</a> / {Name}
      </p>
      <h1 style="max-width:24ch">GTA 6 {Name}, shot by shot</h1>
      <p class="lede">{description}</p>
      <dl class="tally">
        <div><dt>Released</dt><dd><time datetime={video.publishedAt}>{longDate(video.publishedAt)}</time></dd></div>
        <div><dt>Runtime</dt><dd>{video.runtime}</dd></div>
        <div><dt>Moments logged</dt><dd>{shots.length}</dd></div>
        <div><dt>Linked to a page</dt><dd>{linked.length}</dd></div>
        <div><dt>Camera spots solved</dt><dd>{cameras.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <div class="prose">
        <h2 style="margin-top:0">How to read this page</h2>
        <p>
          Each row is one second of {video.title} and the thing visible or
          heard at that second. The time opens the video on YouTube at that
          point. {confirmed} of the {shots.length} rows are plain enough to
          record as confirmed; the rest are marked reported. Where this site
          keeps a page on the thing, the name links to it and the first line
          of that page is shown under it.
        </p>
        <p>
          Confirmed here is a statement about the picture, not about the
          finished game. It says the thing was in the video.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--stone">
    <div class="shell">
      <header class="reel__head">
        <h2 class="reel__title">Every moment, in order</h2>
        <p class="reel__sub">
          {shots.length} moments. <a href={video.url} rel="nofollow noopener">Watch {Name} on YouTube</a>
        </p>
      </header>
      <ol class="reel">
        {shots.map((shot) => (
          <li class="reel__item" id={shot.anchor}>
            <p class="reel__at">
              <a class="reel__clock" href={shot.youtube} rel="nofollow noopener" aria-label={`Play ${Name} from ${shot.timestamp}`}>{shot.timestamp}</a>
            </p>
            <div class="reel__body">
              <p class="reel__what">
                <span class={`tag tag--${shot.type}`}>{TYPE_LABEL[shot.type] || 'Detail'}</span>
                {shot.href
                  ? <a class="reel__name" href={shot.href}>{shot.name}</a>
                  : <span class="reel__name">{shot.name}</span>}
                {!shot.confirmed && <span class="reel__soft">reported</span>}
              </p>
              {shot.note && <p class="reel__note">{shot.note}</p>}
              {shot.entity && (
                <p class="reel__page">
                  {shot.entity.name !== shot.name && <span>Page: {shot.entity.name}. </span>}
                  {trim(shot.entity.shortDescription, 150)}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Ad placement="article" />

  {songs.length > 0 && (
    <section class="band">
      <div class="shell">
        <div class="prose">
          <h2 style="margin-top:0">Songs heard in {Name}</h2>
          <p>
            {songs.length} {songs.length === 1 ? 'song has' : 'songs have'} been named in this
            video. The full table, with every video, is on the
            <a href="/soundtrack#song-timings"> soundtrack page</a>.
          </p>
        </div>
        <div class="scroller">
          <table class="grid">
            <thead>
              <tr>
                <th scope="col">Song</th>
                <th scope="col">Artist</th>
                <th scope="col">Timestamp</th>
                <th scope="col">Scene</th>
              </tr>
            </thead>
            <tbody>
              {songs.map((row) => (
                <tr>
                  <th scope="row"><a href={row.href}>{row.name}</a></th>
                  <td>{row.artist}</td>
                  <td class={row.timestamp === NOT_LOGGED ? 'dim' : 'num'}>{row.timestamp}</td>
                  <td class={row.scene === NOT_LOGGED ? 'dim' : ''}>{row.scene}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {cameras.length > 0 && (
    <section class="band band--stone">
      <div class="shell">
        <div class="prose">
          <h2 style="margin-top:0">Where the shots were filmed</h2>
          <p>
            {cameras.length} camera {cameras.length === 1 ? 'position' : 'positions'} in {Name} have
            been solved by the gtamaplib survey, in the order they appear. The
            survey counts frames, not seconds, so no timestamp is given here.
            The positions are plotted on the
            <a href={cameraGroupUrl(video.id)}> trailer locations map</a>.
          </p>
        </div>
        <div class="scroller">
          <table class="grid">
            <thead>
              <tr>
                <th scope="col">Shot</th>
                <th scope="col">Area</th>
                <th scope="col">Nearest surveyed place</th>
                <th scope="col">Facing</th>
              </tr>
            </thead>
            <tbody>
              {cameras.map((shot) => (
                <tr>
                  <th scope="row">{shot.name}{shot.approximate && <span class="dim"> (about right)</span>}</th>
                  <td>{shot.zoneLabel === 'Not placed in a named area' ? 'Not named' : shot.zoneLabel}</td>
                  <td>{shot.near.length ? `${shot.near[0].name}, ${shot.near[0].m.toLocaleString('en-US')} m` : 'Nothing surveyed nearby'}</td>
                  <td>{shot.compass}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="shell">
      <div class="prose">
        <h2 style="margin-top:0">Where this comes from</h2>
        <p>
          The moments and their timestamps come from the open source
          <a href="https://github.com/tigges/gta" rel="nofollow noopener">tigges/gta</a>
          trailer notes. The camera positions come from
          <a href="https://github.com/NeutralState/gtamaplib" rel="nofollow noopener">gtamaplib</a>,
          which only counts shots solved from official Rockstar material. No
          video and no frame is stored on this site; every time links to the
          original on YouTube.
        </p>
      </div>
      <nav class="pager" aria-label="Other videos">
        {prev ? <a class="pager__btn" href={trailerUrl(prev.id)}>{shortTitle(prev.id).replace(/^the /, '')}</a> : <span></span>}
        <a class="pager__btn" href="/trailers">All three videos</a>
        {next ? <a class="pager__btn" href={trailerUrl(next.id)}>{shortTitle(next.id).replace(/^the /, '')}</a> : <span></span>}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .tally { display: flex; flex-wrap: wrap; gap: 10px 36px; margin: 22px 0 0; }
  .tally div { margin: 0; }
  .tally dt {
    font: 600 11px/1 var(--ui); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--on-glaze-2); margin: 0 0 6px;
  }
  .tally dd { font: 700 22px/1 var(--display); color: var(--on-glaze); margin: 0; font-variant-numeric: tabular-nums; }

  .reel__head { margin: 0 0 22px; padding-bottom: 14px; border-bottom: 1px solid var(--line-strong); }
  .reel__title { font: 700 26px/1.2 var(--display); margin: 0 0 6px; color: var(--ink); }
  .reel__sub { margin: 0; font: 400 15px/1.5 var(--body); color: var(--ink-2); }
  .reel__sub a { color: var(--glaze); }

  .reel { list-style: none; margin: 0; padding: 0; }
  .reel__item {
    display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 0 24px;
    padding: 12px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 90px;
  }
  .reel__item:last-child { border-bottom: 0; }
  .reel__item:target { background: var(--plaster); box-shadow: -12px 0 0 var(--plaster), 12px 0 0 var(--plaster); }
  .reel__at { margin: 0; }
  .reel__clock {
    display: inline-block; font: 600 13px/1 var(--ui); color: var(--ink-2);
    background: var(--chip); border-radius: var(--r); padding: 5px 8px;
    font-variant-numeric: tabular-nums; text-decoration: none;
  }
  a.reel__clock:hover { background: var(--glaze-tint); color: var(--glaze-deep); }
  .reel__body { max-width: var(--prose); }
  .reel__what { margin: 0; font: 400 16px/1.5 var(--body); }
  .reel__name { font-weight: 600; color: var(--ink); }
  a.reel__name { color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--glaze-tint); }
  a.reel__name:hover { border-bottom-color: var(--glaze); }
  .reel__note { margin: 2px 0 0; font: 400 14px/1.5 var(--body); color: var(--ink-2); }
  .reel__page { margin: 6px 0 0; padding-left: 10px; border-left: 2px solid var(--line-strong); font: 400 14px/1.5 var(--body); color: var(--ink-2); }
  .reel__soft {
    margin-left: 8px; font: 600 10px/1 var(--ui); letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--clay);
  }

  .tag {
    display: inline-block; margin-right: 10px; padding: 3px 7px;
    font: 600 10px/1 var(--ui); letter-spacing: 0.08em; text-transform: uppercase;
    border-radius: var(--r); background: var(--chip); color: var(--ink-2);
    vertical-align: 2px;
  }
  .tag--character { background: var(--glaze-tint); color: var(--glaze-deep); }
  .tag--location { background: #dfe6d8; color: #3f5230; }
  .tag--vehicle { background: #e3dcc9; color: var(--brass-ink); }
  .tag--audio { background: #e5dbe6; color: #5d3f60; }
  .tag--reveal { background: #e6dad4; color: var(--clay); }

  .grid { width: 100%; min-width: 560px; border-collapse: collapse; margin: 16px 0 0; font: 400 15px/1.5 var(--body); }
  .grid th, .grid td { text-align: left; padding: 9px 12px 9px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .grid thead th { font: 600 11px/1 var(--ui); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1px solid var(--line-strong); }
  .grid tbody th { font-weight: 600; }
  .grid a { color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--glaze-tint); }
  .grid a:hover { border-bottom-color: var(--glaze); }
  .grid .num { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dim { color: var(--ink-2); font-style: italic; font-weight: 400; }

  .pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin: 26px 0 0; }
  .pager__btn {
    padding: 10px 14px; border: 1px solid var(--line-strong); border-radius: var(--r);
    background: var(--plaster); color: var(--ink); font: 600 14px/1 var(--ui); text-decoration: none;
  }
  .pager__btn:hover { border-color: var(--glaze); color: var(--glaze-deep); }

  @media (max-width: 720px) {
    .reel__item { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
